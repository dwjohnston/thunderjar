THUNDERJAR_REMOTE=1
DOCKER_DEFAULT_PLATFORM=linux/amd64
# CPUs of the Fly machine: the Fly client sizes it performance-<n>x, 2 GB a CPU, when it's idle
FLYIO_INSTANCE_SIZE=16
# Minutes after the last docker command that the Fly machine is stopped, if idle
FLY_SLEEP_MINUTES=30
# Minutes after the last docker command that the Fly machine and its volume are destroyed, if idle
FLY_DESTROY_MINUTES=10080
# Containers run at once per CPU: concurrency is FLYIO_INSTANCE_SIZE x CONCURRENCY_RATIO
CONCURRENCY_RATIO=2.5
