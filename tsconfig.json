{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "types": ["bun"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": true
  },
  // Only the harness: each fixtureTests/ scenario is its own program (see its tsconfig.json).
  "include": ["src", "scripts", "ralph", "fixtureTests/typecheck.test.ts"]
}
