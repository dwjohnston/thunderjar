{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "eqeqeq": "error",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "regex": "^node:"
          }
        ]
      }
    ]
  },
  "ignorePatterns": [
    "node_modules",
    "dist",
    "fixtures/.tmp"
  ],
  "overrides": [
    {
      "files": [
        "src/testing/*"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^node:"
              },
              {
                "regex": "^\\.\\./api(/|$)",
                "message": "src/testing may not import from src/api: a layer may only import from the layers before it. See scripts/layers.ts."
              },
              {
                "regex": "^\\.\\./cli(/|$)",
                "message": "src/testing may not import from src/cli: a layer may only import from the layers before it. See scripts/layers.ts."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/testing/*/*"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^node:"
              },
              {
                "regex": "^\\.\\./\\.\\./api(/|$)",
                "message": "src/testing may not import from src/api: a layer may only import from the layers before it. See scripts/layers.ts."
              },
              {
                "regex": "^\\.\\./\\.\\./cli(/|$)",
                "message": "src/testing may not import from src/cli: a layer may only import from the layers before it. See scripts/layers.ts."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/testing/*/*/*"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^node:"
              },
              {
                "regex": "^\\.\\./\\.\\./\\.\\./api(/|$)",
                "message": "src/testing may not import from src/api: a layer may only import from the layers before it. See scripts/layers.ts."
              },
              {
                "regex": "^\\.\\./\\.\\./\\.\\./cli(/|$)",
                "message": "src/testing may not import from src/cli: a layer may only import from the layers before it. See scripts/layers.ts."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/api/*"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^node:"
              },
              {
                "regex": "^\\.\\./cli(/|$)",
                "message": "src/api may not import from src/cli: a layer may only import from the layers before it. See scripts/layers.ts."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/api/*/*"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^node:"
              },
              {
                "regex": "^\\.\\./\\.\\./cli(/|$)",
                "message": "src/api may not import from src/cli: a layer may only import from the layers before it. See scripts/layers.ts."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/api/*/*/*"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^node:"
              },
              {
                "regex": "^\\.\\./\\.\\./\\.\\./cli(/|$)",
                "message": "src/api may not import from src/cli: a layer may only import from the layers before it. See scripts/layers.ts."
              }
            ]
          }
        ]
      }
    }
  ]
}
