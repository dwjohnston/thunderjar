{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "mcp__claude-artifacts"
    ],
    "ask": [
      "mcp__claude-artifacts__delete_artifact",
      "mcp__claude-artifacts__delete_asset"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/langfuse_hook.py\" || true",
            "timeout": 60
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR\"/src/cli/index.ts capture stop --harness claude-code",
            "timeout": 120
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR\"/src/cli/index.ts capture prompt --harness claude-code",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
