{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "mcp__claude-artifacts__publish_files",
      "mcp__claude-artifacts__edit_version"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/langfuse_hook.py\" || true",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
