{
  "name": "thunderjar",
  "version": "0.1.2",
  "type": "module",
  "description": "Thunderjar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dwjohnston/thunderjar.git"
  },
  "bin": {
    "thunderjar": "./dist/cli.js"
  },
  "main": "./src/api/index.ts",
  "types": "./src/api/index.ts",
  "exports": {
    ".": "./src/api/index.ts"
  },
  "files": [
    "dist",
    "src/api",
    "!src/**/*.test.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/cli/index.ts --target bun --outfile dist/cli.js",
    "lint": "bun scripts/lint-layers.ts --check && oxlint",
    "lint:generate": "bun scripts/lint-layers.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "fixture": "bun scripts/fixture.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:build:versions": "bun scripts/build-versioned-docs.ts",
    "docs:preview": "vitepress preview docs",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish",
    "skills:update": "bunx skills update dwjohnston/agent-skills",
    "skills:add": "bunx skills add dwjohnston/agent-skills"
  },
  "dependencies": {
    "bun": "1.3.14",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@changesets/get-release-plan": "^4.0.16",
    "@types/bun": "^1.4.3",
    "oxlint": "^1.88.0",
    "typescript": "^7.0.2",
    "vitepress": "^2.0.0-alpha.18"
  }
}
