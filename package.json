{
  "name": "thunderjar",
  "version": "0.1.0",
  "type": "module",
  "description": "Thunderjar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dwjohnston/thunderjar.git"
  },
  "bin": {
    "thunderjar": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/cli/index.ts --target bun --outfile dist/cli.js",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "dependencies": {
    "bun": "1.3.14"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/bun": "^1.4.3",
    "oxlint": "^1.88.0",
    "typescript": "^7.0.2",
    "vitepress": "^2.0.0-alpha.18"
  }
}